# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:  mongodb://127.0.0.1:27017/flipkart
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flipkart
MONGO_URI=mongodb://127.0.0.1:27017/flipkart

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE_DAYS=7

# Frontend origin (for CORS + cookies)
CLIENT_URL=http://localhost:5173
