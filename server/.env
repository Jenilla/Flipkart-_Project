# Server
PORT=5000
NODE_ENV=development

# SQLite
# Path to the SQLite database file. The folder is created automatically if
# it doesn't exist. Leave unset to default to server/data/flipkart.sqlite
SQLITE_STORAGE=./data/flipkart.sqlite

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE_DAYS=7

# Frontend origin, only used for CORS when running client/ separately via
# `npm run dev` (split dev mode). Not needed in combined single-port mode,
# since the built frontend is then served from this same origin.
CLIENT_URL=http://localhost:5173
